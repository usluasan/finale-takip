# Sunucuda /opt/docker/finale/finale-takip.env olarak kopyalayın, değerleri doldurun, chmod 600 yapın.
# Bu örnek dosyada gerçek değer YOKTUR; gerçek dosya repoya konmaz.
# Anahtar üretmek için: openssl rand -hex 24
# Giriş uygulamadaki kullanıcı adı + şifreyle yapılır (v0.5.0); APP_KEY artık yok.
# ADMIN_KEY: yalnızca acil durum/yönetim betikleri için (x-key başlığı); ekranda karşılığı yoktur.
ADMIN_KEY=
# NPM + gateway arkasında: istemci IP'si ve HTTPS bilgisi vekil başlıklarından okunur
TRUST_PROXY=1
# Oturum çerezi yalnızca bu uygulamanın yoluna gönderilir (aynı alan adındaki diğer uygulamalara gitmez)
COOKIE_PATH=/finale/
